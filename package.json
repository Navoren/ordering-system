{
  "name": "ordering-system",
  "version": "1.0.0",
  "description": "A high-scale ordering system to learn scale and observability",
  "license": "ISC",
  "author": "Navoren",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node dist/server.js",
    "dev": "nodemon --exec tsx src/server.ts",
